{
  "manifest_version": 3,
  "name": "OmniSaver — Save video & audio",
  "version": "1.0.0",
  "description": "Save video or audio from TikTok, Instagram, X and Facebook. Files download straight from the platform to your device.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.instagram.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.facebook.com/*"
  ],
  "action": {
    "default_title": "Save with OmniSaver",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "omnisaver@harshadprabhu.github.io",
      "strict_min_version": "121.0"
    }
  }
}
